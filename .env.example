# KWIZERA AI STUDIO — production environment template
# Copy to `.env` on the VPS and fill in local values.
# Do not commit `.env` or any secrets.

NODE_ENV=production
KWIZERA_ENV=production

# Bind address. Keep 127.0.0.1 when nginx/caddy terminates TLS in front.
# Set 0.0.0.0 only if the firewall and TLS terminator are already configured.
KWIZERA_HOST=127.0.0.1
KWIZERA_PORT=5173

# Persistent application data (projects, memory, knowledge, uploads, exports).
# Recommended VPS path: /var/lib/kwizera-ai-studio
# Fallback (no root required): $HOME/.local/share/kwizera-ai-studio
KWIZERA_STORAGE_ROOT=/var/lib/kwizera-ai-studio

# Full KWIZERA AI architecture (Core, Memory, Knowledge, Product → Video pipeline).
# Set to 0 only for a workspace-only boot. Do not use 0 in production.
KWIZERA_PERSISTENT_MODE=1

# Never auto-open a browser on the VPS.
KWIZERA_SKIP_BROWSER_OPEN=1

# Optional: absolute path to the git checkout if process cwd is not the project root.
# KWIZERA_PROJECT_ROOT=/opt/kwizera-ai

# Optional: ffmpeg binary for actual video encoding (not required to initialize the pipeline).
# KWIZERA_FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: local Ollama Creative Director / vision (do NOT install large models on small VPS hosts).
# Ollama is optional — deterministic creative planning remains the safety net.
# OLLAMA_HOST=http://127.0.0.1:11434
# KWIZERA_OLLAMA_REASONING_MODEL=llama3.2:1b
# KWIZERA_OLLAMA_VISION_MODEL=llava

# Optional: real image-to-video provider id (leave unset / none for FFmpeg-only production).
# KWIZERA_IMAGE_TO_VIDEO_PROVIDER=none

# Optional GPU resource probes.
# KWIZERA_LRM_EXTERNAL_PROBES=0
