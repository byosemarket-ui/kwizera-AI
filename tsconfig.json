{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ai/*": ["ai/*"],
      "@config/*": ["config/*"],
      "@storage/*": ["storage/*"]
    }
  },
  "include": ["ai/**/*.ts", "storage/**/*.ts", "config/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "dev/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
