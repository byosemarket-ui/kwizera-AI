# KWIZERA HFM MT5 Demo terminal (Wine Staging) — vault-backed login.ini
# Demo-only. No Live login. No order placement. No EA trading activation.
# Password never appears in this unit file or in process argv (only short-lived ini).

[Unit]
Description=KWIZERA HFM MT5 Demo terminal (Wine)
Documentation=file:///opt/kwizera-ai/services/mt5-hfm-lifecycle/README.md
After=network-online.target kwizera-mt5-xvfb.service
Requires=kwizera-mt5-xvfb.service
# Independent of kwizera-ai / forexconnect (vault files + .env passphrase).
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mt5
Group=mt5
UMask=0077
WorkingDirectory=/home/mt5
Environment=HOME=/home/mt5
Environment=USER=mt5
Environment=LOGNAME=mt5
Environment=WINEPREFIX=/home/mt5/.wine-hfm
Environment=WINEARCH=win64
Environment=WINEDEBUG=-all
Environment=DISPLAY=:97
Environment=XAUTHORITY=/home/mt5/.mt5-xauth/Xauthority
Environment=PATH=/opt/wine-staging/bin:/usr/bin:/bin
Environment=KWIZERA_MT5_WINE_BIN=/opt/wine-staging/bin/wine
Environment=KWIZERA_MT5_HFM_RUN_DIR=/run/kwizera/mt5-hfm
Environment=KWIZERA_APP_ROOT=/opt/kwizera-ai
Environment=KWIZERA_STORAGE_ROOT=/var/lib/kwizera-ai-studio

# + = root for vault→ini + chown; wait-display as mt5.
ExecStartPre=+/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/prepare-demo-login-ini.sh
ExecStartPre=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/wait-display.sh
ExecStart=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/start-mt5-demo.sh
ExecStop=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/stop-mt5-demo.sh

Restart=on-failure
RestartSec=20
TimeoutStartSec=120
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

MemoryMax=1G
CPUQuota=70%
Nice=5
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/mt5/.wine-hfm /home/mt5/.mt5-xauth /run/kwizera /tmp
# prepare-demo-login-ini.sh (+root) also uses /run/kwizera/mt5-hfm-stage.
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
