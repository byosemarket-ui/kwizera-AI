# KWIZERA HFM MT5 Demo terminal (Wine Staging)
# PROPOSED — install/enable only after owner approval.
# Demo-only. No Live login. No order placement. No EA / AT trading activation.

[Unit]
Description=KWIZERA HFM MT5 Demo terminal (Wine)
Documentation=file:///opt/kwizera-ai/services/mt5-hfm-lifecycle/README.md
After=network-online.target kwizera-mt5-xvfb.service
Requires=kwizera-mt5-xvfb.service
# Do NOT BindsTo/PartOf/Requires kwizera-ai or kwizera-forexconnect.
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mt5
Group=mt5
UMask=0077
WorkingDirectory=/home/mt5
Environment=HOME=/home/mt5
Environment=USER=mt5
Environment=LOGNAME=mt5
Environment=WINEPREFIX=/home/mt5/.wine-hfm
Environment=WINEARCH=win64
Environment=WINEDEBUG=-all
Environment=DISPLAY=:97
Environment=XAUTHORITY=/home/mt5/.mt5-xauth/Xauthority
Environment=PATH=/opt/wine-staging/bin:/usr/bin:/bin
Environment=KWIZERA_MT5_WINE_BIN=/opt/wine-staging/bin/wine

ExecStartPre=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/wait-display.sh
ExecStart=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/start-mt5-demo.sh
# Prefix-scoped stop only — not a global Wine pkill.
ExecStop=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/stop-mt5-demo.sh

Restart=on-failure
RestartSec=20
TimeoutStartSec=90
TimeoutStopSec=45
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# ~3.3 GiB host; leave headroom for kwizera-ai (~0.6–0.8 GiB) + forexconnect.
MemoryMax=1G
CPUQuota=70%
Nice=5
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
# Wine needs write access to its prefix; do not ProtectSystem=strict without RW paths.
ProtectSystem=full
ReadWritePaths=/home/mt5/.wine-hfm /home/mt5/.mt5-xauth /tmp
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
