# KWIZERA HFM MT5 Demo watchdog — re-login if terminal64 is missing.
# Demo-only. Invokes vault→agent login. Never places orders.

[Unit]
Description=KWIZERA HFM MT5 Demo terminal watchdog (re-login if missing)
Documentation=file:///opt/kwizera-ai/services/mt5-hfm-lifecycle/README.md
After=network-online.target kwizera-mt5-hfm-agent.service kwizera-ai.service
Wants=kwizera-mt5-hfm-agent.service

[Service]
Type=oneshot
User=root
Group=root
Nice=10
TimeoutStartSec=240
ExecStart=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/watchdog-mt5-demo.sh
# Do not restart on failure — timer owns cadence.
RemainAfterExit=no
