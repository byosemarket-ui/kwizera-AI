# KWIZERA HFM MT5 — Xvfb display :97
# PROPOSED — install/enable only after owner approval. Do not reboot VPS to test.
# Migration: if Xvfb :97 is already running manually, this unit will FAIL to bind
# (by design — no pkill). Stop the manual session in a controlled window, then start.

[Unit]
Description=KWIZERA HFM MT5 Xvfb display :97
Documentation=file:///opt/kwizera-ai/services/mt5-hfm-lifecycle/README.md
After=network-online.target
# Independent of kwizera-ai / kwizera-forexconnect — no Requires/BindsTo/PartOf those units.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mt5
Group=mt5
UMask=0077
Environment=HOME=/home/mt5
Environment=USER=mt5
Environment=LOGNAME=mt5
Environment=XAUTHORITY=/home/mt5/.mt5-xauth/Xauthority
Environment=KWIZERA_MT5_XAUTH_DIR=/home/mt5/.mt5-xauth
Environment=KWIZERA_MT5_DISPLAY_NUM=97
WorkingDirectory=/home/mt5

# Host /tmp/.X11-unix must exist (non-root Xvfb cannot create it). Shared with Demo/Wine.
# PrivateTmp MUST stay false: Demo unit and wait-display need the same X11 unix socket.
ExecStartPre=+/usr/bin/mkdir -p /tmp/.X11-unix
ExecStartPre=+/usr/bin/chmod 1777 /tmp/.X11-unix
ExecStartPre=/opt/kwizera-ai/services/mt5-hfm-lifecycle/bin/prepare-xauth.sh
ExecStart=/usr/bin/Xvfb :97 -screen 0 1600x900x24 -nolisten tcp -auth /home/mt5/.mt5-xauth/Xauthority

Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=control-group
KillSignal=SIGTERM

MemoryMax=256M
CPUQuota=20%
Nice=5
LimitCORE=0
NoNewPrivileges=true
# X11 AF_UNIX socket lives under host /tmp/.X11-unix — do not isolate tmp.
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
# /tmp required for Xvfb lock (/tmp/.tX97-lock) + /tmp/.X11-unix/X97 socket.
ReadWritePaths=/home/mt5/.mt5-xauth /tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
