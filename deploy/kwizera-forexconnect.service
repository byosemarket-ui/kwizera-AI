[Unit]
Description=KWIZERA ForexConnect Sidecar (localhost only)
Documentation=file:///opt/kwizera-ai/services/forexconnect-sidecar/README.md
After=network-online.target
Wants=network-online.target
# Optional companion to kwizera-ai — does not replace the main gateway.
# Starts independently; Node talks to 127.0.0.1:5179 only when this unit is active.

[Service]
Type=simple
WorkingDirectory=/opt/kwizera-ai/services/forexconnect-sidecar
User=kwizera
Group=kwizera
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/kwizera-ai/.env
# Hard-bind localhost regardless of misconfigured env.
Environment=KWIZERA_FOREXCONNECT_SIDECAR_HOST=127.0.0.1
Environment=KWIZERA_FOREXCONNECT_SIDECAR_PORT=5179
# Dedicated Python 3.7 venv provisioned by deploy/provision-forexconnect.sh
# (official ForexConnect linux wheels target cp35–cp37).
ExecStart=/opt/kwizera-ai/services/forexconnect-sidecar/.venv/bin/python /opt/kwizera-ai/services/forexconnect-sidecar/server.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kwizera-forexconnect
NoNewPrivileges=true
PrivateTmp=true
# Do not publish this service; Node gateway talks to 127.0.0.1:5179 only.

[Install]
WantedBy=multi-user.target
