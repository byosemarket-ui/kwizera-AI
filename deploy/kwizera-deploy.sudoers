# One-time VPS install (as root):
#   install -m 440 deploy/kwizera-deploy.sudoers /etc/sudoers.d/kwizera-deploy
# Replace "kwizera" if the GitHub Actions SSH user is different.
# visudo -c -f /etc/sudoers.d/kwizera-deploy
Defaults:kwizera !requiretty
kwizera ALL=(root) NOPASSWD:SETENV: /opt/kwizera-ai/deploy/update-from-github.sh
kwizera ALL=(root) NOPASSWD:SETENV: /opt/kwizera-ai/deploy/update-from-github.sh [A-Fa-f0-9]*
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase1-online-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase2-online-vision-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase3-creative-reasoning-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase4-online-i2v-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase5-audio-timeline-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase6-qa-delivery-verify.sh
kwizera ALL=(root) NOPASSWD: /bin/bash /opt/kwizera-ai/deploy/phase6-qa-delivery-verify.sh
